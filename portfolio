function about(){return `<div class="wrap"><h2 id="about">About</h2><div class="two"><div><p>I am a third-year Creative Technologies student at KdG in Antwerp, Belgium. What I enjoy most is environment design: houses, architecture and props that tell a story and share one theme and atmosphere. I like thinking through a whole environment, lore included, before I build it.</p><p>Fantasy and the medieval world are my home ground. I also love sci-fi, though I have not built in it yet. I make physical things too, from soldering a console to designing a bottle.</p><p>I am looking for an internship in games, interactive or XR, where I can build environments.</p><p class="mono" style="margin-bottom:6px">Languages</p><div class="chips"><span>English</span><span>Dutch</span><span>Russian</span><span>Ukrainian</span><span>Czech</span></div><p class="mono" style="margin-bottom:6px">Skills</p><div class="chips">${ic("blender","Blender")}${ic("unity","Unity")}${am("Ai","Adobe Illustrator")}${am("Pr","Adobe Premiere Pro")}${am("Ps","Adobe Photoshop")}${am("Ae","Adobe After Effects")}</div></div><figure style="margin:0"><img src="${IMG.me}" alt="Portrait of Heorhii Andruskyi"><figcaption>Heorhii (George) Andruskyi</figcaption></figure></div><h2 id="contact">Contact</h2><p>Email: <a class="ext" href="mailto:andrusjora@gmail.com">andrusjora@gmail.com</a><br>GitHub: <a class="ext" href="https://github.com/gogdushegub" target="_blank" rel="noopener">gogdushegub</a><br>ArtStation: <a class="ext" href="https://www.artstation.com/heorhiiandruskyi7" target="_blank" rel="noopener">heorhiiandruskyi7</a><br>LinkedIn: <a class="ext" href="https://www.linkedin.com/in/heorhii-andruskyi-776614446/" target="_blank" rel="noopener">heorhii-andruskyi</a><br>CV: <a class="ext" href="Heorhii_Andruskyi_CV_EN_NL.pdf" target="_blank" rel="noopener">Download (English and Dutch, PDF)</a></p></div>`}
