function stream(){return `<div class="wrap"><section class="hero"><div><h1>Heorhii<small>(George)</small>Andruskyi</h1><p class="lead">I design game environments with stories built into them, and I model 3D objects and products of every kind. I am curious about everything and passionate about what I do. Looking for an internship in games, 3D, interactive or XR.</p></div>${dial}</section><section class="car" aria-label="Projects"><div class="trk">${P.filter(p=>COV[p.s]).map(p=>tile(p)).join("")}${P.filter(p=>COV[p.s]).map(p=>tile(p,1)).join("")}</div></section></div>${portfolio()}${about()}`}
