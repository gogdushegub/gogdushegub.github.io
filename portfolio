function car(){const c=document.querySelector(".car");if(!c)return;const rm=matchMedia("(prefers-reduced-motion:reduce)").matches;let hov=0,dir=0,hold=0,last=performance.now(),pos=0;
const half=()=>c.scrollWidth/2;pos=c.scrollLeft=half()*.5;
c.addEventListener("pointermove",e=>{if(e.pointerType!=="mouse")return;const r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5;hov=1;dir=Math.abs(x)<.12?0:x*2});
c.addEventListener("pointerleave",()=>{hov=0;dir=0});
["pointerdown","wheel","touchstart"].forEach(n=>c.addEventListener(n,()=>{hold=performance.now()+2500},{passive:true}));
c.addEventListener("focusin",()=>{hov=1;dir=0});c.addEventListener("focusout",()=>{hov=0});
const f=t=>{const dt=Math.min(t-last,50)/1000;last=t;const hf=half();if(Math.abs(c.scrollLeft-pos)>2)pos=c.scrollLeft;
if(!rm&&t>hold)pos+=(hov?dir*340:36)*dt;
const mx=2*hf-c.clientWidth-2;if(pos>=mx)pos-=hf;if(pos<=2)pos+=hf;c.scrollLeft=pos;raf=requestAnimationFrame(f)};raf=requestAnimationFrame(f)}
function err(e){document.getElementById("app").innerHTML='<div class="wrap"><p>Something went wrong loading this page: '+e.message+"</p></div>"}
addEventListener("hashchange",()=>{try{route()}catch(e){err(e)}});try{route()}catch(e){err(e)}
